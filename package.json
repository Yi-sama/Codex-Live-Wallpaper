  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yi-sama/Codex-Live-Wallpaper.git"
  },
  "bugs": {
    "url": "https://github.com/Yi-sama/Codex-Live-Wallpaper/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
